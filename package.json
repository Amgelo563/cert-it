{
  "name": "cert-it",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "dev": "pnpm --filter @cert-it/public build && pnpm --parallel --filter @cert-it/server --filter @cert-it/admin --filter @cert-it/public dev",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test",
    "bench": "pnpm --filter @cert-it/server bench",
    "build": "vp run -r build"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.12.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "pnpm@12.8.1"
}
