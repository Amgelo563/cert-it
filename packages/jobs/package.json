{
  "name": "@cert-it/jobs",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@cert-it/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "coverage": "vp test run --coverage",
    "barrel": "barrelsby --directory ./src --delete --singleQuotes --noHeader --exclude messages"
  },
  "dependencies": {
    "@cert-it/data": "workspace:^",
    "@cert-it/shared": "workspace:^",
    "better-result": "^3.0.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.12.0",
    "barrelsby": "2.8.1",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4"
  }
}
