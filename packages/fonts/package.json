{
  "name": "@cert-it/fonts",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@cert-it/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "@cert-it/source": "./src/node/index.ts",
      "default": "./dist/node.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./node": "./dist/node.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "coverage": "vp test run --coverage",
    "barrel": "barrelsby --directory ./src --delete --singleQuotes --noHeader --exclude node && barrelsby --directory ./src/node --delete --singleQuotes --noHeader"
  },
  "dependencies": {
    "@cert-it/file": "workspace:^",
    "@cert-it/shared": "workspace:^",
    "@types/fontkit": "2.0.9",
    "better-result": "^3.0.1",
    "fontkit": "2.0.4"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.12.0",
    "barrelsby": "2.8.1",
    "vite-plus": "catalog:"
  }
}
